{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "1.1.0",
  "description": "Blocks YouTube and Reddit, keeps Facebook locked to /messages (including in-app navigation), and sends every site to http://focus/plan until today's first tasks are done.",
  "permissions": ["webNavigation", "tabs"],
  "host_permissions": ["http://focus/*", "*://*.facebook.com/*", "*://*.youtube.com/*", "*://youtu.be/*", "*://*.reddit.com/*", "*://redd.it/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["facebook.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
